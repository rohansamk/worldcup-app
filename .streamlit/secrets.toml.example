# This file is ONLY needed when deploying to Streamlit Community Cloud.
# When running locally, the app reads .streamlit/service_account.json instead
# (just drop the JSON file you downloaded from GCP there — no copying required).
#
# For deploy: open the Streamlit Cloud app's Settings → Secrets and paste
# the contents below, filled in from your service account JSON.
# DO NOT commit a real secrets.toml — .gitignore already excludes it.

[gcp_service_account]
type = "service_account"
project_id = "your-gcp-project-id"
private_key_id = "..."
# Keep the literal \n escapes in the key; TOML will preserve them as-is.
private_key = "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
client_email = "wc-app@your-gcp-project-id.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/wc-app%40your-gcp-project-id.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
